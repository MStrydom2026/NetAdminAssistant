{
  "manifest_version": 3,
  "name": "NetAdmin Assistant - Sage 300 Support Helper",
  "version": "0.5.3",
  "description": "AI-powered ticket analyzer for Sage 300 support. Analyzes NetAdmin tickets and suggests solutions.",
  "author": "MStrydom2026",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://netadmin.*/",
    "https://*.sage.com/*"
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "NetAdmin Assistant"
  },
  "side_panel": {
    "default_path": "html/sidepanel.html",
    "default_title": "NetAdmin Analysis"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://netadmin.*/*",
        "https://*.sage.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["html/sidepanel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
