# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# AI Provider Configuration
# Options: "azure", "openai", "mock" (for testing without API)
AI_PROVIDER=azure

# Azure OpenAI Configuration (for Sage organization)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-org.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI Configuration (fallback/legacy)
# Only used if AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4-turbo

# Database Configuration
DB_PATH=./data/netadmin-assistant.db
DB_ENABLE_JOURNAL=true

# Feature Flags
ENABLE_LOCAL_ANALYSIS=true
ENABLE_ATTACHMENT_PROCESSING=true
ENABLE_TICKET_CACHING=true
MAX_CACHE_AGE_HOURS=24

# Rate Limiting
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Security
ALLOW_LOCALHOST_ONLY=true
CORE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
