# NetAdmin Test Backend environment
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# OpenAI-compatible local engine
AI_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=local-test
OPENAI_MODEL=gpt-4o-mini

# For Ollama, use these instead:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=your-installed-ollama-model

DB_PATH=./data/netadmin-assistant.db
DB_ENABLE_JOURNAL=true
ENABLE_LOCAL_ANALYSIS=true
ENABLE_ATTACHMENT_PROCESSING=false
ENABLE_TICKET_CACHING=true
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1000
ALLOW_LOCALHOST_ONLY=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
